import inspect
def add(a: int, b: int = 2) -> int:
    return a + b

async def fetch(url):
    return url

inspect.iscoroutinefunction(add)
inspect.iscoroutinefunction(fetch)
coro = fetch("x")
inspect.iscoroutine(coro)
coro.close()
sig = inspect.signature(add)
sig
list(sig.parameters)
sig.parameters["b"].default
sig.bind(1)
sig.bind()
